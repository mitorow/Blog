---

{
  SOLID[name] && (
    <svg class="tile__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={SOLID[name]} />
    </svg>
  )
}
{
  LINE[name] && (
    <svg
      class="tile__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={LINE[name]}
    />
  )
}
