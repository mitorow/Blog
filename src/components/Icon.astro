---
/**
 * トップページの Links / Works タイルで使うアイコン。
 *
 * 気に入らないときの戻し方:
 *   - アイコンだけ差し替えたい  -> 下の SOLID / LINE の該当パスを書き換える
 *   - 画像(PNG)に戻したい      -> src/data/links.yml / sections.yml の `icon:` の行を消す
 *                                 (icon が無いタイルは image の画像を表示します)
 *   - アイコンごと消したい      -> `icon:` も `image:` も消す(文字だけのタイルになります)
 */
interface Props {
  name: string;
}
const { name } = Astro.props;

