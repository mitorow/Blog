---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SECTIONS, formatDate } from '../lib/site';
import profile from '../data/profile.yml';
import links from '../data/links.yml';
import skills from '../data/skills.yml';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const p = profile as {
  name: string;
  bio?: string;
  facts?: string[];
};
const linkCards = links as {
  label: string;
  note?: string;
  url: string;
  color?: string;
  icon?: string;
  image?: string | null;
}[];
const skillTiles = skills as { name: string; note?: string; icon?: string; color?: string }[];
---

<BaseLayout title="Home" hero>
  <div class="home-layout">
    {/* ============ 左側: 文章のカード ============ */}
    <div class="home-col home-col--main">
      {/* プロフィール(内容は src/data/profile.yml で編集) */}
      <div class="card">
        <span class="label">About Me</span>
        <div class="profile__name"><b>{p.name}</b></div>
        <div class="profile__bio">
          {p.bio?.split('\n').filter(Boolean).map((line) => <p>{line}</p>)}
        </div>
        {
          p.facts && p.facts.length > 0 && (
            <ul class="profile__facts">
              {p.facts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
          )
        }
      </div>

      {/* 最新記事 */}
      <div class="card">
        <span class="label">Blog</span>
        <ul class="mini-posts">
          {
            posts.length === 0 ? (
              <li>
                <a href="/blog/">まだ記事がありません</a>
              </li>
            ) : (
              posts.slice(0, 5).map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <span>{post.data.title}</span>
                  </a>
                </li>
              ))
            )
          }
        </ul>
      </div>

      {/* スキル(内容は src/data/skills.yml で編集) */}
      {
        skillTiles.length > 0 && (
          <div class="card">
            <span class="label">Skills</span>
            <div class="tiles">
              {skillTiles.map((skill) => (
                <div class:list={['tile', skill.color ?? 'chip-0']}>
                  {skill.icon && <Icon name={skill.icon} />}
                  <b>{skill.name}</b>
                  {skill.note && <small>{skill.note}</small>}
                </div>
              ))}
            </div>
          </div>
        )
      }

      {/* ↓ ここは中身が決まるまでの仮置きです。好きな内容に差し替えてください */}
      <div class="card">
        <span class="label">Coming Soon</span>
        <div class="placeholder">
          <p>ここに新しいコンテンツが入ります。</p>
        </div>
      </div>

      {/* 文章のカードを増やしたいときはここに .card を足してください */}
    </div>

    {/* ============ 右側: リンクのカード ============ */}
    <div class="home-col home-col--side">
      {/* 外部リンク(内容は src/data/links.yml で編集) */}
      {
        linkCards.length > 0 && (
          <div class="card">
            <span class="label">Links</span>
            <div class="tiles">
              {linkCards.map((link) => (
                <a
                  class:list={['tile', 'tile--link', link.color ?? 'chip-0']}
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer">
                  {link.icon ? (
                    <Icon name={link.icon} />
                  ) : (
                    link.image && <img class="tile__img" src={link.image} alt="" />
                  )}
                  <b>{link.label}</b>
                  {link.note && <small>{link.note}</small>}
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* 作ったものへの入口(内容は src/data/sections.yml で編集) */}
      {
        SECTIONS.length > 0 && (
          <div class="card">
            <span class="label">Works</span>
            <div class="tiles">
              {SECTIONS.map((s) => (
                <a class:list={['tile', 'tile--link', s.color ?? 'chip-0']} href={`/${s.slug}/`}>
                  {s.icon ? (
                    <Icon name={s.icon} />
                  ) : (
                    s.image && <img class="tile__img" src={s.image} alt="" />
                  )}
                  <b>{s.label}</b>
                  {s.note && <small>{s.note}</small>}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
